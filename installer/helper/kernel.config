# The helper VM's kernel: arm64 defconfig plus what building the iOS disk needs,
# built in (no modules in the initramfs). QEMU virt, direct -kernel boot.
CONFIG_HFSPLUS_FS=y
CONFIG_NLS=y
CONFIG_NLS_UTF8=y
CONFIG_FUSE_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_MAGIC_SYSRQ=y

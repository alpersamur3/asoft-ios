          "note": "PC only (AEA decryption on Windows); the phone needs its own decryption path"
        },
        "qemuPc": {
          "version": "2026.11.03",
          "url": "https://github.com/alpersamur3/qemu-sptm/releases/download/asoft-7364c4e/asoft-qemu-2026.11.03.zip",
          "sha256": "C0D48F95ABEB467D8AFDE898BF2987123C60F19D62CFC8400C446F0569E4D5C2"
        }
      },
      "steps": [
        {
          "id": "setup",
          "title": "Setup: work folder, GPU driver, config, scripts",
          "kind": "always"
        },
        {
          "id": "prereq",
          "title": "Windows prerequisites",
          "kind": "always"
        },
        {
          "id": "python",
          "title": "Python for the Windows-side tools",
          "kind": "once"
        },
        {
          "id": "qemu",
          "title": "QEMU and the GPU library",
          "kind": "once"
        },
        {
          "id": "linux",
          "title": "The Linux steps' tools: WSL 2 or the helper VM and ipsw.exe",
          "kind": "once"
        },
        {
          "id": "sysroot",
          "title": "darwin-vm's iOS sysroot",
          "kind": "once"
        },
        {
          "id": "cloudos",
          "title": "cloudOS 26.4b files (Apple)",
          "kind": "once"
        },
        {
          "id": "iphone",
          "title": "iPhone17,3 iOS 26.6.2 files (Apple, about 10 GB)",
          "kind": "once"
        },
        {
          "id": "decrypt",
          "title": "Decrypt the OS and SystemOS images",
          "kind": "once",
          "linux": [
            {
              "name": "decrypt"
            }
          ],
          "helper": "ipsw.exe fw aea on Windows"
        },
        {
          "id": "firmware",
          "title": "Firmware: device tree, kernelcache, SPTM, TXM",
          "kind": "once",
          "linux": [
            {
              "name": "firmware"
            }
          ],
          "helper": "ipsw.exe on Windows"
        },
        {
          "id": "devicetree",
          "title": "The device trees for 4 and 8 vCPUs",
          "kind": "once",
          "python": [
            "dt-root26smp.py fw/dtree.orig dtree-smpN --cpus N (QEMU_SPTM=tools/qemu-sptm)",
            "dt-aod.py dtree-smpN dtree-smpN-aod"
          ]
        },
        {
          "id": "ramdisk",
          "title": "Sysroot check and the shell ramdisk",
          "kind": "once",
          "linux": [
            {
              "name": "ramdisk",
              "disks": [
                {
                  "ro": "install/work/rd.apfs",
                  "at": "/root/ios26/rd/rd.apfs"
                }
              ],
              "in": [
                "downloads/ios_sysroot.tar.gz",
                "cloudos/Firmware/{RAMDISK}.trustcache"
              ],
              "out": [
                "rd-shell.hfs",
                "cloud/rd.trustcache.im4p"
              ]
            }
          ]
        },
        {
          "id": "gpudriver",
          "title": "The guest GPU driver, out of cloudOS (iOS 26 and watchOS share it)",
          "kind": "once",
          "shared": true,
          "linux": [
            {
              "name": "gpu-driver",
              "disks": [
                {
                  "ro": "install/work/gpu-img/{IMG}",
                  "at": "cloudos/{IMG}"
                }
              ],
              "in": [
                "cloudos/Firmware/{IMG}.aea.trustcache"
              ],
              "out": [
                "install/work/gpu"
              ]
            }
          ],
          "python": [],
          "out": [
            "gpu-driver/{BUNDLE}"
          ],
          "note": "Runs once for iOS 26 and watchOS. gpu-driver's body is a one-liner in the PS1 (bash $S/cloudos-gpu-driver.sh cloudos/{IMG}[.aea] install/work/gpu cloudos/Firmware/{IMG}.aea.trustcache); the compiler plugin is then copied into the bundle and the bundle is moved to gpu-driver/{BUNDLE}, then the image is dropped. iOS 26's gpu step and watchOS's gpu step read gpu-driver/{BUNDLE}."
        },
        {
          "id": "rootfs",
          "title": "The root file system (root26.qcow2)",
          "kind": "chain",
          "linux": [
            {
              "name": "rootfs",
              "disks": [
                {
                  "ro": "os/{OS}"
                },
                {
                  "ro": "os/{SYSOS}"
                },
                {
                  "ro": "iphone/{APPOS}"
                },
                {
                  "new": "root26.qcow2",
                  "size": "32G"
                }
              ],
              "in": [
                "downloads/ios_sysroot.tar.gz"
              ],
              "out": [
                "root26.qcow2.hashes"
              ]
            }
          ]
        },
        {
          "id": "trustcache",
          "title": "Its trust cache (root26.tc)",
          "kind": "chain",
          "python": [
            "mktc.py -2 root26.tc iphone/{OS}.aea.trustcache iphone/{SYSOS}.aea.trustcache iphone/{APPOS}.trustcache root26.qcow2.hashes"
          ]
        },
        {
          "id": "partition",
          "title": "The partitioned disk (root26g.qcow2)",
          "kind": "chain",
          "linux": [
            {
              "name": "partition",
              "disks": [
                {
                  "ro": "root26.qcow2"
                },
                {
                  "new": "root26g.qcow2",
                  "size": "root26.qcow2's virtual size + 16 GiB + 2 MiB"
                }
              ]
            }
          ]
        },
        {
          "id": "tweaks",
          "title": "Prefs, keybag, launchd trims",
          "kind": "chain",
          "linux": [
            {
              "name": "tweaks",
              "disks": [
                {
                  "rw": "root26g.qcow2"
                }
              ]
            }
          ]
        },
        {
          "id": "firstboot",
          "title": "First boot (iOS writes its persona files)",
          "kind": "chain",
          "boot": "root26g.qcow2 with root26.tc and the plain device tree, until /private/var/keybags/persona.kb and usersession.kb"
        },
        {
          "id": "persona",
          "title": "Persona and MobileGestalt fixes",
          "kind": "chain",
          "linux": [
            {
              "name": "persona",
              "disks": [
                {
                  "rw": "root26g.qcow2"
                }
              ]
            }
          ]
        },
        {
          "id": "activation",
          "title": "Activation (root26-activation.qcow2)",
          "kind": "chain",
          "linux": [
            {
              "name": "activation-get",
              "disks": [
                {
                  "rw": "root26-activation.qcow2",
                  "overlay": "root26g.qcow2"
                }
              ],
              "out": [
                "install/work/mobileactivationd.orig"
              ]
            },
            {
              "name": "activation-put",
              "disks": [
                {
                  "rw": "root26-activation.qcow2"
                }
              ],
              "in": [
                "install/work/mobileactivationd"
              ]
            }
          ],
          "python": [
            "hact_patch.py install/work/mobileactivationd.orig install/work/mobileactivationd",
            "reattest.py install/work/mobileactivationd.orig install/work/mobileactivationd (prints OLD NEW CDHashes)",
            "tc-like.py root26-activation.tc root26.tc OLD NEW"
          ]
        },
        {
          "id": "apps",
          "title": "Apps, dyld cache patches, gestures (root26-apps.qcow2)",
          "kind": "chain",
          "linux": [
            {
              "name": "apps-get",
              "disks": [
                {
                  "rw": "root26-apps.qcow2",
                  "overlay": "root26-activation.qcow2"
                },
                {
                  "ro": "os/{OS}"
                }
              ],
              "out": [
                "dsc"
              ]
            },
            {
              "name": "apps-put",
              "disks": [
                {
                  "rw": "root26-apps.qcow2"
                },
                {
                  "ro": "os/{OS}"
                }
              ],
              "in": [
                "dsc",
                "dscpatch"
              ]
            }
          ],
          "python": [

+    "#asoft-sidebar { background-color: #161a24; padding: 10px; }"
+    "#asoft-sidebar button { background-image: none; background-color: #252b3a;"
+    "  color: #e6e9f0; border: 1px solid #2f3648; border-radius: 9px;"
+    "  padding: 6px 10px; box-shadow: none; text-shadow: none; -gtk-icon-shadow: none; }"
+    "#asoft-sidebar button label { color: #e6e9f0; }"
+    "#asoft-sidebar button:hover { background-color: #303850; border-color: #3a4360; }"
+    "#asoft-sidebar button:active { background-color: #3a4460; }"
+    "#asoft-sidebar button:disabled { background-color: #1d2230; border-color: #232838; }"
+    "#asoft-sidebar button:disabled label { color: #5b6377; }"
+    "#asoft-sidebar button.accent { background-color: #3d7bf5; border-color: #4a86f7; }"
+    "#asoft-sidebar button.accent:hover { background-color: #5590f8; }"
+    "#asoft-sidebar button.accent:disabled { background-color: #1d2230; border-color: #232838; }"
+    "#asoft-sidebar button.danger:hover { background-color: #b8343d; border-color: #c9434c; }"
+    "#asoft-sidebar separator { background-color: #262c3b; min-height: 1px; }"

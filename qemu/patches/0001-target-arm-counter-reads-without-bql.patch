diff --git a/target/arm/tcg/op_helper.c b/target/arm/tcg/op_helper.c
index c4433be..0537311 100644
--- a/target/arm/tcg/op_helper.c
+++ b/target/arm/tcg/op_helper.c
@@ -1240,7 +1240,7 @@ uint32_t HELPER(get_cp_reg)(CPUARMState *env, const void *rip)
     const ARMCPRegInfo *ri = rip;
     uint32_t res;
 
-    if (ri->type & ARM_CP_IO) {
+    if ((ri->type & (ARM_CP_IO | ARM_CP_IO_READ_NOBQL)) == ARM_CP_IO) {
         bql_lock();
         res = ri->readfn(env, ri);
         bql_unlock();
@@ -1269,7 +1269,7 @@ uint64_t HELPER(get_cp_reg64)(CPUARMState *env, const void *rip)
     const ARMCPRegInfo *ri = rip;
     uint64_t res;
 
-    if (ri->type & ARM_CP_IO) {
+    if ((ri->type & (ARM_CP_IO | ARM_CP_IO_READ_NOBQL)) == ARM_CP_IO) {
         bql_lock();
         res = ri->readfn(env, ri);
         bql_unlock();
diff --git a/target/arm/tcg/translate-a64.c b/target/arm/tcg/translate-a64.c
index 1780490..09912b4 100644
--- a/target/arm/tcg/translate-a64.c
+++ b/target/arm/tcg/translate-a64.c
@@ -3222,7 +3222,9 @@ static void handle_sys(DisasContext *s, bool isread,
         g_assert_not_reached();
     }
 
-    if (ri->type & ARM_CP_IO) {
+    if ((ri->type & ARM_CP_IO) &&
+        !(isread && (ri->type & ARM_CP_IO_READ_NOBQL) &&
+          !(tb_cflags(s->base.tb) & CF_USE_ICOUNT))) {
         /* I/O operations must end the TB here (whether read or write) */
         need_exit_tb = translator_io_start(&s->base);
     }

+/*
+ * PSCI conduit: SMC to TrustZone on the phone. QEMU virt has no EL3 and
+ * emulates PSCI behind HVC instead; its ADT says so with
+ * /chosen/sweet-psci-conduit = "hvc" (tools/mkadt.py --qemu).
+ */
+static bool sweet_psci_hvc;
+
+static void
+sweet_psci_select_conduit(void)
+{
+	DTEntry chosen;
+	char const *conduit;
+	unsigned int size;
+	sweet_psci_hvc = SecureDTLookupEntry(NULL, "/chosen", &chosen) == kSuccess &&
+	    SecureDTGetProperty(chosen, "sweet-psci-conduit", (void const **)&conduit, &size) == kSuccess &&
+	    size >= 4 && strncmp(conduit, "hvc", size) == 0;
+	IOLog("SWEET CPU: PSCI conduit %s\n", sweet_psci_hvc ? "hvc" : "smc");
+}
+
 /* SMCCC 1.0: x0 is the signed PSCI result; do not assume x1-x17 survive. */
 static int32_t
 sweet_psci_cpu_on(uint64_t target, uint64_t entry, uint64_t context)
@@ -33,9 +53,15 @@ sweet_psci_cpu_on(uint64_t target, uint64_t entry, uint64_t context)
 	register uint64_t x1 __asm__("x1") = target;
 	register uint64_t x2 __asm__("x2") = entry;
 	register uint64_t x3 __asm__("x3") = context;
-	__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
-	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
-	    "x14", "x15", "x16", "x17", "cc", "memory");
+	if (sweet_psci_hvc) {
+		__asm__ volatile("hvc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+		    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+		    "x14", "x15", "x16", "x17", "cc", "memory");
+	} else {
+		__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+		    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+		    "x14", "x15", "x16", "x17", "cc", "memory");
+	}
 	return (int32_t)x0;
 }
 

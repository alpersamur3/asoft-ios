-	    topology->num_cpus > SWEET_SMP_MAX_CPUS) {
+	/* MPIDR Aff1 = core on the phone (0x000-0x500 A55, 0x600/0x700 A76);
+	 * QEMU virt numbers its CPUs in Aff0 (0-7). */
+	bool phone_mpidr = cpu->phys_id <= 0x700 && (cpu->phys_id & 0xff) == 0;
+	bool qemu_mpidr = cpu->phys_id < SWEET_SMP_MAX_CPUS;
+	if (!(phone_mpidr || qemu_mpidr) || topology->num_cpus > SWEET_SMP_MAX_CPUS) {
 		panic("SWEET CPU: invalid topology cpu=%u mpidr=0x%x count=%u",
 		    cpu->cpu_id, cpu->phys_id, topology->num_cpus);
 	}

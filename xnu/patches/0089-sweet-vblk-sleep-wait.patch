+/*
+ * Wait until the device has consumed the request. Under QEMU TCG every timer
+ * read (CNTVCT) takes QEMU's global lock, which the main loop also needs to
+ * complete the request: yield first, then sleep in CMD_SLEEP_NS steps when the
+ * context allows it, instead of delay(1), which reads the timer continuously.
+ */
+static int
+vblk_wait_used(volatile struct vq_used *used, uint32_t type, uint64_t sector)
+{
+	for (int i = 0; i < CMD_SPINS; i++) {
+		if (used->idx != vb.used_idx) {
+			return 0;
+		}
+		__builtin_arm_yield();
+	}
+	bool sleepable = ml_get_interrupts_enabled() && !ml_at_interrupt_context() &&
+	    get_preemption_level() == 0;
+	uint64_t now = mach_absolute_time(), deadline, interval;
+	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
+	nanoseconds_to_absolutetime(CMD_SLEEP_NS, &interval);
+	deadline += now;
+	while (used->idx == vb.used_idx) {
+		if (now > deadline) {
+			printf("SWEET VBLK: request type %u sector 0x%llx timed out\n", type, sector);
+			return ETIMEDOUT;
+		}
+		if (sleepable) {
+			/* Keep the mutex: the queue and the bounce buffer are still owned. */
+			if (assert_wait_deadline_with_leeway((event_t)&vb.used_idx, THREAD_UNINT,
+			    TIMEOUT_URGENCY_SYS_CRITICAL, now + interval, 0) == THREAD_WAITING) {
+				thread_block(THREAD_CONTINUE_NULL);
+			}
+		} else {
+			for (int i = 0; i < CMD_SPINS && used->idx == vb.used_idx; i++) {
+				__builtin_arm_yield();
+			}
+		}
+		now = mach_absolute_time();
+	}
+	return 0;
+}
+

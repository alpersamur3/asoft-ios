+int
+SweetPlatformExpert::haltRestart(unsigned int type)
+{
+	if (sweet_psci_hvc && (type == kPEHaltCPU || type == kPEUPSDelayHaltCPU || type == kPERestartCPU)) {
+		sweet_psci_system(type == kPERestartCPU ? PSCI_SYSTEM_RESET : PSCI_SYSTEM_OFF);
+	}
+	return IODTPlatformExpert::haltRestart(type);
+}

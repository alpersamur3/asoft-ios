+/*
+ * Power off. QEMU's power key (monitor command system_powerdown, or closing
+ * the window with qemu/patches/0003) is a line of the virt machine's PL061
+ * GPIO (ADT node /sweet-power-key: absolute reg, gpio-line). The PL061
+ * latches the press (rising edge) in its raw interrupt status, polled every
+ * 250 ms. A press starts the kernel's own shutdown, reboot_kernel(RB_HALT):
+ * every process gets SIGTERM and then SIGKILL, the disks are synced and
+ * unmounted (HFS+ closes its journal cleanly), and the final halt powers
+ * QEMU off with PSCI SYSTEM_OFF (a restart: SYSTEM_RESET). Without the PSCI
+ * HVC conduit (the phone) halt and restart behave as before.
+ */
+#define PL061_IEV       0x40c   /* interrupt event: 1 = rising edge */
+#define PL061_RIS       0x414   /* raw interrupt status (latched edges) */
+#define PL061_IC        0x41c   /* interrupt clear */
+#define PSCI_SYSTEM_OFF         0x84000008U
+#define PSCI_SYSTEM_RESET       0x84000009U
+
+static volatile uint32_t *sweet_gpio;
+static uint32_t sweet_power_mask;
+static thread_call_t sweet_power_call;
+static bool sweet_psci_hvc;
+
+static void
+sweet_power_arm(void)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(250, NSEC_PER_MSEC, &deadline);
+	thread_call_enter_delayed(sweet_power_call, deadline);
+}
+
+static void
+sweet_power_poll(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	if (!(sweet_gpio[PL061_RIS / 4] & sweet_power_mask)) {
+		sweet_power_arm();
+		return;
+	}
+	sweet_gpio[PL061_IC / 4] = sweet_power_mask;
+	IOLog("SWEET POWER: power key, shutting down\n");
+	reboot_kernel(RB_HALT, NULL);   /* returns only when a shutdown is already running */
+}
+
+/* SMCCC 1.0 through HVC (QEMU virt's PSCI); x1-x17 may be clobbered. */
+static void
+sweet_psci_system(uint64_t function)
+{
+	register uint64_t x0 __asm__("x0") = function;
+	__asm__ volatile("hvc #0" : "+r"(x0) : :
+	    "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+	    "x14", "x15", "x16", "x17", "cc", "memory");
+}
+

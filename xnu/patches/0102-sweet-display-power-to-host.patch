+/*
+ * The display's power state to the host: the keyboard's Scroll Lock LED, lit
+ * while the display is off (iokit/Kernel/arm/SweetFramebuffer.cpp calls this
+ * for every power request of iOS). QEMU takes a statusq buffer in the notify
+ * itself, so the few descriptors are simply reused in turn. No EV_SYN: QEMU's
+ * virtio-input knows only EV_LED on this queue.
+ */
+void
+sweet_vinput_display_power(int on)
+{
+	lck_mtx_lock(&vin_sts_lock);
+	for (unsigned d = 0; d < vin_count; d++) {
+		struct vinput *v = &vin[d];
+		if (!v->sts_ready || v->abs_max[0]) {
+			continue;                       /* keyboards only */
+		}
+		uint16_t id = (uint16_t)(v->sts_idx % STS_QUEUE_SIZE);
+		struct input_event *e = (struct input_event *)(v->dma + DMA_STS_EVENTS) + id;
+		*e = (struct input_event){ EV_LED, LED_SCROLLL, on ? 0 : 1 };
+		((struct vq_desc *)(v->dma + DMA_STS_DESC))[id] = (struct vq_desc){
+			v->dma_pa + DMA_STS_EVENTS + id * sizeof(struct input_event),
+			(uint32_t)sizeof(struct input_event), 0, 0 };
+		volatile uint16_t *avail = (volatile uint16_t *)(v->dma + DMA_STS_AVAIL);   /* flags, idx, ring[] */
+		avail[2 + id] = id;
+		__builtin_arm_dmb(0xb);
+		avail[1] = ++v->sts_idx;
+		__builtin_arm_dsb(0xf);
+		vi_wr(v, VIRTIO_QUEUE_NOTIFY, 1);
+	}
+	lck_mtx_unlock(&vin_sts_lock);
+}

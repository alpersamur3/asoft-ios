diff --git a/iokit/conf/Makefile.template b/iokit/conf/Makefile.template
index 7613d9b..86f97ae 100644
--- a/iokit/conf/Makefile.template
+++ b/iokit/conf/Makefile.template
@@ -57,6 +57,15 @@ COMP_SUBDIRS = \
 
 %MACHDEP
 
+# Apple OSS IONetworkingFamily built in (iokit/sweet_net, staged by
+# xnu/patches/0094-stage-ionetworking.sh): compiled as upstream wrote it,
+# with the SDK's TargetConditionals.h staged next to it; see sweet_net_compat.h.
+SWEET_NET_OBJS = IOEthernetController.cpo IOEthernetInterface.cpo IOKernelDebugger.cpo IOMbufMemoryCursor.cpo IONetworkController.cpo IONetworkData.cpo IONetworkInterface.cpo IONetworkMedium.cpo IONetworkStack.cpo IONetworkUserClient.cpo IOOutputQueue.cpo IOPacketQueue.cpo
+$(foreach o,$(SWEET_NET_OBJS),$(eval $(o)_CXXWARNFLAGS_ADD += -Wno-everything) $(eval $(o)_CFLAGS_ADD += -include $(SRCROOT)/iokit/sweet_net/sweet_net_compat.h) $(eval $(o)_INCFLAGS += -I$(SRCROOT)/iokit/sweet_net -I$(SRCROOT)/bsd))
+# SweetVirtioNet subclasses the family's controller: same __PRIVATE_SPI__
+# (else its vtable names the reserved slots the SPI methods replace).
+SweetVirtioNet.cpo_CFLAGS_ADD += -D__PRIVATE_SPI__=1

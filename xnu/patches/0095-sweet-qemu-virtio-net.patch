--- /dev/null
+++ b/iokit/sweet_net/sweet_net_compat.h
@@ -0,0 +1,32 @@
+/*
+ * SWEET: Apple's IONetworkingFamily (staged into iokit/sweet_net by
+ * xnu/patches/0094-stage-ionetworking.sh) built into the kernel.
+ * iokit/conf/Makefile.template force-includes this header in every source
+ * of the family, and adds bsd/ to their include path for the KPI headers a
+ * kext finds in Kernel.framework but the kernel build does not export
+ * (net/classq/classq.h, from net/dlil.h).
+ *
+ * - The family includes BSD headers inside extern "C" { }. Inside the
+ *   kernel they reach kalloc/zalloc and startup.h, whose C++ templates need
+ *   C++ linkage, and bpf.h reaches Skywalk's IOKit header, which needs
+ *   OSMetaClass.h. Those come first here, as C++; their include guards keep
+ *   the later extern "C" includes from opening them again. They declare
+ *   their C functions inside __BEGIN_DECLS themselves.
+ * - The kext's project defines __PRIVATE_SPI__. The SPI methods take reserved
+ *   vtable slots, so a subclass compiled without it names placeholders that
+ *   then do not exist (SweetVirtioNet.cpo gets the define as well).
+ */
+#ifndef SWEET_NET_COMPAT_H
+#define SWEET_NET_COMPAT_H
+
+#define __PRIVATE_SPI__ 1
+
+#ifdef __cplusplus
+#include <libkern/c++/OSMetaClass.h>
+#include <kern/startup.h>
+#include <kern/locks.h>
+#include <kern/zalloc.h>
+#include <kern/kalloc.h>
+#endif
+
+#endif /* SWEET_NET_COMPAT_H */

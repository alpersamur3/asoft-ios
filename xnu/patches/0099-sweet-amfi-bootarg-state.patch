diff --git a/bsd/kern/sweet_amfi.c b/bsd/kern/sweet_amfi.c
index cb67b4d..79cc5f1 100644
--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -305,8 +305,42 @@ sweet_sandbox_syscall(struct proc *p, int call, __unused user_addr_t arg)
 	}
 }
 
+/*
+ * Policy "AMFI": libmis calls __mac_syscall("AMFI", op, arg) through
+ * __sandbox_ms. lsd asks for the boot-arg state (op 0x60,
+ * amfi_interface_query_bootarg_state) before it reads the ExtensionKit
+ * extension point cache; when that fails ("Unable to find AMFI") no
+ * extension point is registered and no ExtensionKit extension (posters,
+ * widgets) ever runs: the wallpaper stays black. The state is a uint64_t
+ * of AMFI boot-arg flags; SWEET sets none, so it is 0, as on a device
+ * booted without them. Every other operation still fails with ENOPOLICY,
+ * as it did before the policy had this name. The first use of each
+ * operation number is logged.
+ */
+#define SWEET_AMFI_OP_BOOTARG_STATE     0x60
+
+static uint64_t sweet_amfi_seen[2];
+
+static int
+sweet_amfi_syscall(struct proc *p, int call, user_addr_t arg)
+{
+	if (call >= 0 && call < 128 &&
+	    !(sweet_amfi_seen[call / 64] & (1ULL << (call % 64)))) {
+		sweet_amfi_seen[call / 64] |= 1ULL << (call % 64);
+		char name[32];
+		proc_name(proc_pid(p), name, sizeof(name));
+		printf("SWEET AMFI: %s op 0x%x\n", name, call);
+	}
+	if (call == SWEET_AMFI_OP_BOOTARG_STATE) {
+		uint64_t state = 0;
+		return copyout(&state, arg, sizeof(state));
+	}
+	return ENOPOLICY;
+}
+
 static const struct mac_policy_ops sweet_amfi_mac_ops = {
 	.mpo_vnode_check_signature = sweet_amfi_vnode_check_signature,
+	.mpo_policy_syscall = sweet_amfi_syscall,
 };
 
 /*
@@ -360,7 +394,7 @@ static struct mac_policy_conf sweet_sandbox_mac_conf = {
 static mac_policy_handle_t sweet_sandbox_mac_handle;
 
 static struct mac_policy_conf sweet_amfi_mac_conf = {
-	.mpc_name = "SWEET AMFI",
+	.mpc_name = "AMFI",
 	.mpc_fullname = "SWEET built-in Mobile File Integrity",
 	.mpc_ops = &sweet_amfi_mac_ops,
 };

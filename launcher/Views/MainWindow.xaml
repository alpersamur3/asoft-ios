<Window x:Class="ASoftware.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ASoftware.Views"
        xmlns:e="clr-namespace:ASoftware.Engine"
        Title="ASoftware" Width="1220" Height="800" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterScreen" Icon="/Assets/logo.ico"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
        <DataTemplate x:Key="CardTemplate" DataType="{x:Type v:OsCardVm}">
            <Border Width="270" Margin="10" CornerRadius="20" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                <Border.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="5" Direction="270" Opacity="0.18" Color="#000000"/></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="168"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <v:ClipBorder CornerRadius="19,19,0,0" Background="{Binding Gradient}">
                        <Grid>
                            <Ellipse Width="220" Height="220" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-90,-70,0" Fill="#18FFFFFF"/>
                            <v:DeviceGlyph Os="{Binding Os}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,22,18,0"/>
                            <StackPanel VerticalAlignment="Bottom" Margin="20,0,0,16">
                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontSize="27" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="White" Opacity="0.85" Margin="1,1,0,0"/>
                            </StackPanel>
                        </Grid>
                    </v:ClipBorder>
                    <StackPanel Grid.Row="1" Margin="20,16,20,20">
                        <Border Style="{StaticResource Pill}" Background="{Binding StateSoft}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{Binding StateBrush}" VerticalAlignment="Center" Margin="0,1,7,0"/>
                                <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="12" FontWeight="SemiBold" AutomationProperties.AutomationId="{Binding StateId}"/>
                            </StackPanel>
                        </Border>
                        <ProgressBar Style="{StaticResource Bar}" Margin="0,12,0,0" Maximum="100" Value="{Binding Progress}" Visibility="{Binding ShowProgress, Converter={StaticResource Vis}}"/>
                        <TextBlock Text="{Binding Line1}" Style="{StaticResource Sub}" Margin="0,11,0,0" MinHeight="34"/>
                        <TextBlock Text="{Binding Line2}" Style="{StaticResource Faint}" Margin="0,3,0,0" MinHeight="16"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button Style="{StaticResource BtnPrimary}" Command="{Binding PrimaryCmd}" IsEnabled="{Binding PrimaryEnabled}" Padding="12,9" AutomationProperties.AutomationId="{Binding PrimaryId}" AutomationProperties.Name="{Binding Primary}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding PrimaryIcon}" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,1,8,0"/>
                                    <TextBlock Text="{Binding Primary}"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource Btn}" Command="{Binding MoreCmd}" Margin="8,0,0,0" Width="42" Padding="0,9" ToolTip="{Binding MoreText}" AutomationProperties.AutomationId="{Binding MoreId}">
                                <TextBlock Text="&#xE712;" FontFamily="{StaticResource Icons}" FontSize="14"/>
                            </Button>
                        </Grid>
                        <Grid Margin="0,8,0,0" Visibility="{Binding Running, Converter={StaticResource Vis}}">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button Style="{StaticResource Btn}" Command="{Binding SaveCloseCmd}" IsEnabled="{Binding CanSave}" Padding="6,8" AutomationProperties.AutomationId="{Binding SaveId}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,1,6,0"/>
                                    <TextBlock Text="{Binding SaveCloseText}" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource BtnDanger}" Command="{Binding TurnOffCmd}" Margin="8,0,0,0" Padding="12,8" AutomationProperties.AutomationId="{Binding OffId}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,1,6,0"/>
                                    <TextBlock Text="{Binding TurnOffText}" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- a soft light behind the header -->
        <Ellipse Width="900" Height="420" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-200,-260,0,0" IsHitTestVisible="False" Opacity="0.9">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#335B8CFF" Offset="0"/>
                    <GradientStop Color="#005B8CFF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Margin="30,22,26,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="12" ClipToBounds="True">
                    <Image Source="/Assets/logo-256.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="ASoftware" Style="{StaticResource H1}" FontSize="24"/>
                    <TextBlock Text="{Binding [Tagline], Source={x:Static e:L.I}}" Style="{StaticResource Sub}" Margin="1,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="InstallButton" Style="{StaticResource BtnPrimary}" Padding="16,9" Click="Install_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center" Margin="0,1,9,0"/>
                            <TextBlock Text="{Binding [InstallDots], Source={x:Static e:L.I}}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnIcon}" Margin="8,0,0,0" Click="Settings_Click" Content="&#xE713;" ToolTip="{Binding [Settings], Source={x:Static e:L.I}}"/>
                </StackPanel>
            </Grid>

            <!-- banners: a new version, an install to resume, a restart -->
            <StackPanel x:Name="Banners" Grid.Row="1" Margin="30,4,30,0"/>

            <!-- pages -->
            <ScrollViewer x:Name="Home" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,6,20,24">
                <StackPanel>
                    <ItemsControl x:Name="Cards" ItemTemplate="{StaticResource CardTemplate}" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <!-- this PC: memory, the drives the guests are on, the GPU -->
                    <WrapPanel x:Name="PcStrip" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                </StackPanel>
            </ScrollViewer>
            <ContentControl x:Name="Page" Grid.Row="2" Visibility="Collapsed" Focusable="False"/>
        </Grid>

        <!-- a note at the bottom (what happened, an error) -->
        <Border x:Name="SnackBar" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,24" CornerRadius="12" Padding="16,11"
                Background="{DynamicResource Surface3}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" Visibility="Collapsed" MaxWidth="760">
            <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.3" Color="#000000"/></Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="SnackIcon" Text="&#xE946;" FontFamily="{StaticResource Icons}" FontSize="15" VerticalAlignment="Top" Margin="0,2,12,0" Foreground="{DynamicResource Info}"/>
                <TextBlock x:Name="SnackText" Grid.Column="1" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Style="{StaticResource BtnIcon}" Width="28" Height="28" Margin="12,-4,-6,-4" FontSize="11" Content="&#xE711;" Click="SnackClose_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>

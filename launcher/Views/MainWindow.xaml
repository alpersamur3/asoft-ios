<Window x:Class="ASoftware.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ASoftware.Views"
        xmlns:e="clr-namespace:ASoftware.Engine"
        Title="ASoftware" Width="1220" Height="800" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterScreen" Icon="/Assets/logo.ico"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
        <!-- one system on the shelf: its device standing on the baseline, its name, state and buttons under it; the
             device row's height follows the window's (MainWindow.FitDevices) -->
        <DataTemplate x:Key="CardTemplate" DataType="{x:Type v:OsCardVm}">
            <Grid Width="270">
                <Grid.RowDefinitions>
                    <RowDefinition Height="{Binding DeviceRow}"/>
                    <RowDefinition Height="Auto" SharedSizeGroup="Info"/>
                    <RowDefinition Height="Auto" SharedSizeGroup="Actions"/>
                </Grid.RowDefinitions>
                <v:DeviceArt Os="{Binding Os}" Height="{Binding DeviceHeight}" Shot="{Binding Shot}" Present="{Binding Present}" Awake="{Binding Awake}"
                             Progress="{Binding DeviceProgress}" Command="{Binding DeviceCmd}" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
                <StackPanel Grid.Row="1" Margin="12,14,12,0">
                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource Text}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Detail}" FontSize="12.5" Foreground="{DynamicResource Text3}" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Ellipse Width="7" Height="7" Fill="{Binding StateBrush}" VerticalAlignment="Center" Margin="0,1,8,0"/>
                        <TextBlock Text="{Binding StateText}" FontSize="13" Foreground="{DynamicResource Text2}" TextWrapping="Wrap" MaxWidth="228"
                                   AutomationProperties.AutomationId="{Binding StateId}"/>
                    </StackPanel>
                    <!-- (two lines' room in every state, so the shelf keeps its height as states change) -->
                    <StackPanel Margin="0,4,0,0" MinHeight="32">
                        <TextBlock Text="{Binding Line1}" Style="{StaticResource Faint}" TextAlignment="Center"/>
                        <TextBlock Text="{Binding Line2}" Style="{StaticResource Faint}" TextAlignment="Center"/>
                    </StackPanel>
                    <ProgressBar Style="{StaticResource Bar}" Width="160" Margin="0,8,0,0" Maximum="100" Value="{Binding Progress}" Visibility="{Binding ShowProgress, Converter={StaticResource Vis}}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="PrimaryButton" Style="{Binding PrimaryStyle}" Content="{Binding Primary}" Command="{Binding PrimaryCmd}" IsEnabled="{Binding PrimaryEnabled}" MinWidth="112"
                                AutomationProperties.AutomationId="{Binding PrimaryId}" AutomationProperties.Name="{Binding Primary}"/>
                        <Button Style="{StaticResource BtnRound}" Command="{Binding MoreCmd}" Margin="10,0,0,0" Content="&#xE712;" ToolTip="{Binding MoreText}"
                                AutomationProperties.AutomationId="{Binding MoreId}" AutomationProperties.Name="{Binding MoreText}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0" Visibility="{Binding Running, Converter={StaticResource Vis}}">
                        <Button Style="{StaticResource BtnLink}" Content="{Binding SaveCloseText}" Command="{Binding SaveCloseCmd}" IsEnabled="{Binding CanSave}"
                                Visibility="{Binding SaveCloseVisibility, Mode=OneTime}" AutomationProperties.AutomationId="{Binding SaveId}"/>
                        <Button Style="{StaticResource BtnDanger}" Content="{Binding TurnOffText}" Command="{Binding TurnOffCmd}" Margin="{Binding TurnOffMargin, Mode=OneTime}"
                                AutomationProperties.AutomationId="{Binding OffId}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Margin="30,16,24,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="11" ClipToBounds="True">
                    <Image Source="/Assets/logo-256.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="ASoftware" Style="{StaticResource H1}" FontSize="23"/>
                    <TextBlock Text="{Binding [Tagline], Source={x:Static e:L.I}}" Style="{StaticResource Sub}" Margin="1,1,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="InstallButton" Style="{StaticResource Btn}" Click="Install_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center" Margin="0,1,8,0"/>
                            <TextBlock Text="{Binding [InstallDots], Source={x:Static e:L.I}}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnIcon}" Margin="8,0,0,0" Click="Settings_Click" Content="&#xE713;" ToolTip="{Binding [Settings], Source={x:Static e:L.I}}"
                            AutomationProperties.Name="{Binding [Settings], Source={x:Static e:L.I}}"/>
                </StackPanel>
            </Grid>

            <!-- banners: a new version, an install to resume, a restart -->
            <StackPanel x:Name="Banners" Grid.Row="1" Margin="30,2,30,0"/>

            <!-- pages -->
            <ScrollViewer x:Name="Home" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="30,4,30,16" Focusable="False"
                          SizeChanged="Home_SizeChanged">
                <StackPanel>
                    <!-- the shelf: the systems side by side, as a line-up -->
                    <Border x:Name="Shelf" CornerRadius="24" BorderThickness="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
                            Padding="16,22,16,16" SizeChanged="Shelf_SizeChanged">
                        <ItemsControl x:Name="Cards" ItemTemplate="{StaticResource CardTemplate}" HorizontalAlignment="Center" Focusable="False" Grid.IsSharedSizeScope="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel ItemWidth="270"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Border>
                    <!-- install on a phone, report a problem -->
                    <Grid x:Name="Tools" Margin="0,12,0,0" SizeChanged="Tools_SizeChanged"/>
                    <!-- this PC: memory, the drives the guests are on, the GPU -->
                    <TextBlock x:Name="PcLine" SizeChanged="Part_SizeChanged" Margin="12,14,12,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Text3}"/>
                </StackPanel>
            </ScrollViewer>
            <ContentControl x:Name="Page" Grid.Row="2" Visibility="Collapsed" Focusable="False"/>
        </Grid>

        <!-- a note at the bottom (what happened, an error) -->
        <Border x:Name="SnackBar" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,24" CornerRadius="16" Padding="16,10,8,10"
                Background="{DynamicResource Surface3}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" Visibility="Collapsed" MaxWidth="760">
            <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.3" Color="#000000"/></Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Ellipse x:Name="SnackDot" Width="7" Height="7" VerticalAlignment="Top" Margin="0,7,12,0" Fill="{DynamicResource Info}"/>
                <TextBlock x:Name="SnackText" Grid.Column="1" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Style="{StaticResource BtnIcon}" Width="28" Height="28" Margin="10,-4,0,-4" FontSize="10" Content="&#xE711;" Click="SnackClose_Click"
                        AutomationProperties.Name="{Binding [Close], Source={x:Static e:L.I}}"/>
            </Grid>
        </Border>
    </Grid>
</Window>

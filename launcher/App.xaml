<Application x:Class="ASoftware.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:ASoftware.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- the colours are set by Engine\Theme.cs (dark / light) as these keys; these are the dark ones -->
        <SolidColorBrush x:Key="Bg" Color="#000000"/>
        <LinearGradientBrush x:Key="Surface" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#19191C" Offset="0"/>
            <GradientStop Color="#111113" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="Surface2" Color="#1C1C1F"/>
        <SolidColorBrush x:Key="Surface3" Color="#2A2A2E"/>
        <SolidColorBrush x:Key="Line" Color="#26262A"/>
        <SolidColorBrush x:Key="LineStrong" Color="#3A3A3F"/>
        <SolidColorBrush x:Key="Text" Color="#F5F5F7"/>
        <SolidColorBrush x:Key="Text2" Color="#A1A1A6"/>
        <SolidColorBrush x:Key="Text3" Color="#86868B"/>
        <SolidColorBrush x:Key="Hover" Color="#12FFFFFF"/>
        <SolidColorBrush x:Key="Pressed" Color="#20FFFFFF"/>
        <SolidColorBrush x:Key="Accent" Color="#6CB2FF"/>
        <SolidColorBrush x:Key="Good" Color="#32D74B"/>
        <SolidColorBrush x:Key="Warn" Color="#FF9F0A"/>
        <SolidColorBrush x:Key="Bad" Color="#FF5A50"/>
        <SolidColorBrush x:Key="Info" Color="#6CB2FF"/>
        <SolidColorBrush x:Key="Idle" Color="#48484A"/>
        <SolidColorBrush x:Key="Track" Color="#2A2A2E"/>
        <SolidColorBrush x:Key="SwitchOff" Color="#39393D"/>
        <SolidColorBrush x:Key="SegOn" Color="#3A3A3F"/>
        <SolidColorBrush x:Key="Fill" Color="#F5F5F7"/>
        <SolidColorBrush x:Key="FillHover" Color="#D9D9DE"/>
        <SolidColorBrush x:Key="FillPressed" Color="#C2C2C8"/>
        <SolidColorBrush x:Key="FillText" Color="#0B0B0D"/>

        <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>

        <!-- half the height as the corner radius: a capsule at any size -->
        <v:CapsuleRadius x:Key="Capsule"/>

        <!-- text -->
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        </Style>
        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        </Style>
        <Style x:Key="H3" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Faint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Text3}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- keyboard focus: a 2 px ring in the accent, only when the keyboard moved it there -->
        <Style x:Key="FocusCapsule">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="-3" BorderThickness="2" BorderBrush="{DynamicResource Accent}" SnapsToDevicePixels="True"
                                CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource Capsule}}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FocusRound">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="-3" BorderThickness="2" BorderBrush="{DynamicResource Accent}" CornerRadius="19" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FocusText">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="-2" BorderThickness="2" BorderBrush="{DynamicResource Accent}" CornerRadius="6" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- buttons: Btn an outline capsule, BtnPrimary the light capsule, BtnLink / BtnDanger text links,
             BtnGhost a quiet text button (Back), BtnIcon a round ghost, BtnRound a round outline, BtnRow a hairline row -->
        <ControlTemplate x:Key="CapsuleTemplate" TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"
                    CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource Capsule}}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource CapsuleTemplate}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusCapsule}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Hover}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource Pressed}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{DynamicResource Fill}"/>
            <Setter Property="Foreground" Value="{DynamicResource FillText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource FillHover}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource FillPressed}"/></Trigger>
            </Style.Triggers>
        </Style>

        <!-- a link: underlined while the pointer is on it -->
        <DataTemplate x:Key="LinkText">
            <TextBlock x:Name="t" Text="{Binding}" TextWrapping="NoWrap"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter TargetName="t" Property="TextDecorations" Value="Underline"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="BtnLink" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="2,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusText}"/>
            <Setter Property="ContentTemplate" Value="{StaticResource LinkText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.7"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnLink}">
            <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
        </Style>
        <Style x:Key="BtnGhost" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                    <Setter Property="Background" Value="{DynamicResource Hover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <ControlTemplate x:Key="RoundTemplate" TargetType="Button">
            <Grid>
                <Ellipse x:Name="e" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{Binding BorderThickness.Left, RelativeSource={RelativeSource TemplatedParent}}"/>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="BtnIcon" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource RoundTemplate}"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusCapsule}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Hover}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource Pressed}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BtnRound" TargetType="Button" BasedOn="{StaticResource BtnIcon}">
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="BtnRow" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRound}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="16">
                            <Grid>
                                <Border x:Name="o" CornerRadius="15" Background="Transparent"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="o" Property="Background" Value="{DynamicResource Hover}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="o" Property="Background" Value="{DynamicResource Pressed}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a segmented control (RadioButtons in a SegBox): the chosen one a lighter capsule on the track -->
        <Style x:Key="SegBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource Capsule}}"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="Seg" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusCapsule}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Padding="14,5" Background="Transparent" MinHeight="28"
                                CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource Capsule}}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource SegOn}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                <Setter TargetName="b" Property="Effect">
                                    <Setter.Value><DropShadowEffect BlurRadius="5" ShadowDepth="1" Direction="270" Opacity="0.14" Color="#000000"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a toggle switch: green when on, as on iOS -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusCapsule}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border x:Name="track" Width="42" Height="25" CornerRadius="12.5" Background="{DynamicResource SwitchOff}" VerticalAlignment="Center">
                                <Border x:Name="knob" Width="21" Height="21" CornerRadius="10.5" Background="White" HorizontalAlignment="Left" Margin="2,0">
                                    <Border.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.25"/></Border.Effect>
                                </Border>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource Good}"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a check card (the install choice): CheckBox with any content; chosen: a ring in the text colour and a filled tick -->
        <Style x:Key="CheckCard" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRound}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="b" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Surface}" Padding="16">
                                <Grid>
                                    <ContentPresenter/>
                                    <Grid x:Name="tick" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Ellipse x:Name="ring" Stroke="{DynamicResource LineStrong}" StrokeThickness="1.5"/>
                                        <Ellipse x:Name="disc" Fill="{DynamicResource Text}" Visibility="Hidden"/>
                                        <TextBlock x:Name="t" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Bg}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden"/>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border x:Name="sel" CornerRadius="16" BorderThickness="1.5" BorderBrush="{DynamicResource Text}" Visibility="Hidden" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource LineStrong}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="sel" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="disc" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="t" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ring" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RadioCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRound}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="b" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Surface}" Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Grid Width="20" Height="20" VerticalAlignment="Top" Margin="0,0,14,0">
                                        <Ellipse x:Name="ring" Stroke="{DynamicResource LineStrong}" StrokeThickness="1.5"/>
                                        <Ellipse x:Name="disc" Fill="{DynamicResource Text}" Visibility="Hidden"/>
                                        <TextBlock x:Name="t" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Bg}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden"/>
                                    </Grid>
                                    <ContentPresenter Grid.Column="1"/>
                                </Grid>
                            </Border>
                            <Border x:Name="sel" CornerRadius="16" BorderThickness="1.5" BorderBrush="{DynamicResource Text}" Visibility="Hidden" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource LineStrong}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="sel" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="disc" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="t" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ring" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- text fields -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource LineStrong}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- progress: a thin bar -->
        <Style x:Key="Bar" TargetType="ProgressBar">
            <Setter Property="Height" Value="3"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="Background" Value="{DynamicResource Track}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" ClipToBounds="True"
                                CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource Capsule}}">
                            <Grid>
                                <Border x:Name="PART_Track"/>
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"
                                        CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource Capsule}}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- thin scroll bars -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="3" Background="{DynamicResource LineStrong}" Margin="1,0"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track" Margin="2">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border CornerRadius="3" Background="{DynamicResource LineStrong}" Margin="0,1"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource Surface3}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MaxWidth" Value="380"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
